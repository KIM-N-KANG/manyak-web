# API (BFF 프록시 대상이자 pnpm api:generate의 OpenAPI 스펙 출처)
API_BASE_URL=

# Amplitude (비워두면 로컬/dev에서 이벤트 미전송 — 콘솔 디버그 로그만)
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# Meta 픽셀 (광고 전환 추적. 비워두면 미전송 — 콘솔 디버그 로그만. 프로덕션 환경에만 설정)
NEXT_PUBLIC_META_PIXEL_ID=

# Sentry
# DSN (Sentry 프로젝트 설정에서 발급. 비워두면 이벤트 미전송)
NEXT_PUBLIC_SENTRY_DSN=
# 기본적으로 프로덕션에서만 이벤트 전송. 로컬에서 연동 확인 시 true
NEXT_PUBLIC_SENTRY_FORCE_ENABLE=

# Auth (NextAuth — 모두 서버 전용)
# AUTH_SECRET은 `openssl rand -base64 32`로 생성
AUTH_SECRET=

# Google Cloud Console OAuth 클라이언트 (redirect URI: {origin}/api/auth/callback/google)
# 이 client ID는 백엔드 허용 목록(manyak-infra .env의 MANYAK_GOOGLE_CLIENT_IDS)에도 등록돼야 로그인이 통과한다(401 방지)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 카카오 개발자 콘솔 REST API 키·Client Secret (redirect URI: {origin}/api/auth/callback/kakao)
# 이 REST API 키는 백엔드 허용 목록(manyak-infra .env의 MANYAK_KAKAO_CLIENT_IDS)에도 등록돼야 로그인이 통과한다(401 방지)
# 아래 NEXT_PUBLIC_KAKAO_JS_KEY와는 다른 키다. 로그인은 REST API 키, 공유는 JS 키를 쓴다
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=

# 카카오 JS SDK (친구 초대 공유. 로그인용 키는 위 AUTH_KAKAO_ID)
NEXT_PUBLIC_KAKAO_JS_KEY=

# 실기기 dev 테스트용 교차 출처 허용 목록(콤마 구분, 예: 터널 도메인·LAN IP)
ALLOWED_DEV_ORIGINS=
